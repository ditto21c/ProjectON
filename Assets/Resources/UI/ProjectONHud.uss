    height: 44px;
}

.command-bar {
    left: 0;
    right: 0;
    bottom: 0;
    height: 132px;
    background-color: rgba(4, 5, 6, 0.90);
}

.log-panel {
    left: 16px;
    bottom: 146px;
    width: 564px;
    height: 44px;
    background-color: rgba(5, 6, 7, 0.68);
}

.log-text {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    bottom: 0;
    color: rgb(237, 230, 184);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.end-state-panel {
    left: 50%;
    top: 50%;
    width: 520px;
    height: 248px;
    translate: -260px -124px;
    background-color: rgba(4, 6, 8, 0.94);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(96, 123, 132);
    border-right-color: rgb(96, 123, 132);
    border-bottom-color: rgb(23, 30, 34);
    border-left-color: rgb(96, 123, 132);
}

.end-state-title {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 18px;
    height: 42px;
    color: rgb(242, 236, 190);
    font-size: 25px;
    -unity-text-align: middle-center;
}

.end-state-body {
    position: absolute;
    left: 28px;
    right: 28px;
    top: 72px;
    height: 74px;
    color: rgb(222, 234, 235);
    font-size: 16px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.end-state-button {
    top: 168px;
    width: 142px;
    height: 48px;
    font-size: 14px;
}

.end-state-load-button {
    left: 34px;
}

.end-state-new-run-button {
    left: 189px;
}

.end-state-continue-button {
    left: 344px;
}

.toolbar-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.toolbar-slot {
    position: absolute;
}

.projecton-button {
    position: absolute;
    background-color: rgba(33, 41, 46, 0.96);
    color: rgb(235, 240, 235);
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 1px;
    padding-bottom: 1px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(61, 74, 82);
    border-right-color: rgb(61, 74, 82);
    border-bottom-color: rgb(15, 20, 23);
    border-left-color: rgb(61, 74, 82);
}

.projecton-button:hover {
    background-color: rgb(56, 71, 79);
}

.projecton-button:active {
    background-color: rgb(23, 31, 36);
}

.fill-button {
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.schedule-button {
    top: 5px;
    bottom: 5px;
    width: 106px;
}

.schedule-start-down {
    left: 8px;
}

.schedule-start-up {
    left: 122px;
}

.schedule-wake-down {
    left: 236px;
}

.schedule-wake-up {
    left: 350px;
}

.action-button {
    top: 14px;
    bottom: 14px;
}

.save-button {
    right: 468px;
    width: 132px;
}

.load-button {
    right: 324px;
    width: 132px;
}

.pause-button {
    right: 180px;
    width: 132px;
}

.speed-button {
    right: 18px;
    width: 150px;
}

.mode-selected {
    background-color: rgb(56, 97, 115);
}

.overlay-selected {
    background-color: rgb(92, 76, 38);
}

.hidden {
    display: none;
}
