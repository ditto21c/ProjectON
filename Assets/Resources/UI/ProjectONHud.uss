.projecton-hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-panel {
    position: absolute;
}

.top-bar {
    left: 0;
    right: 0;
    top: 0;
    height: 88px;
    background-color: rgba(4, 5, 6, 0.88);
}

.stats-text {
    position: absolute;
    left: 18px;
    right: 36%;
    top: 10px;
    bottom: 10px;
    color: rgb(224, 237, 242);
    font-size: 16px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.mode-text {
    position: absolute;
    left: 65%;
    right: 18px;
    top: 8px;
    bottom: 8px;
    color: rgb(255, 235, 173);
    font-size: 14px;
    -unity-text-align: middle-right;
    white-space: normal;
}

.overlay-panel {
    left: 600px;
    top: 96px;
    width: 620px;
    height: 42px;
    background-color: rgba(4, 5, 6, 0.72);
}

.overlay-legend-panel {
    left: 600px;
    top: 146px;
    width: 620px;
    height: 78px;
    background-color: rgba(4, 5, 6, 0.66);
}

.overlay-legend-title {
    position: absolute;
    left: 10px;
    top: 6px;
    width: 150px;
    height: 18px;
    color: rgb(238, 232, 196);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.overlay-legend-rows {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 28px;
    bottom: 8px;
    flex-direction: row;
    flex-wrap: wrap;
}

.overlay-legend-row {
    width: 150px;
    height: 21px;
    flex-direction: row;
    align-items: center;
}

.overlay-legend-swatch {
    width: 18px;
    height: 13px;
    margin-left: 2px;
    margin-right: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(230, 236, 235, 0.70);
    border-right-color: rgba(230, 236, 235, 0.70);
    border-bottom-color: rgba(10, 14, 16, 0.90);
    border-left-color: rgba(230, 236, 235, 0.70);
}

.overlay-legend-label {
    width: 120px;
    color: rgb(221, 231, 231);
    font-size: 12px;
    -unity-text-align: middle-left;
}

.schedule-panel {
    left: 1068px;
    top: 96px;
    width: 468px;
    height: 42px;
    background-color: rgba(4, 5, 6, 0.72);
}

.language-panel {
    left: 1548px;
    top: 96px;
    width: 144px;
    height: 42px;
    background-color: rgba(4, 5, 6, 0.72);
}

.scenario-panel {
    left: 16px;
    bottom: 198px;
    width: 564px;
    height: 116px;
    background-color: rgba(5, 7, 9, 0.76);
}

.scenario-text {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 8px;
    bottom: 8px;
    color: rgb(226, 237, 231);
    font-size: 15px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.inspect-panel {
    right: 16px;
